# FizzBuzz: Print numbers 1 to 100
# For multiples of 3: print "Fizz"
# For multiples of 5: print "Buzz" 
# For multiples of both 3 and 5: print "FizzBuzz"
# For all other numbers: print the number

make i get 1

jaara (i small pass 101) start
    if na so (i mod 15 na 0) start
        shout("FizzBuzz")
    end
    if no be so start
        if na so (i mod 3 na 0) start
            shout("Fizz")
        end
        if no be so start
            if na so (i mod 5 na 0) start
                shout("Buzz")
            end
            if no be so start
                shout(i)
            end
        end
    end
    i get i add 1
end