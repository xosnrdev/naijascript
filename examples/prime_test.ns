# Primality Testing Algorithm
# Demonstrates trial division with square root optimization

do is_prime(n) start
    if na so (n small pass 2) start
        return false
    end
    if na so (n na 2) start
        return true
    end
    if na so (n mod 2 na 0) start
        return false
    end
    
    # Check odd divisors up to sqrt(n)
    make i get 3
    jaara (i times i small pass n add 1) start
        if na so (n mod i na 0) start
            return false
        end
        i get i add 2
    end
    return true
end

# Test cases
make test_nums get 100
make i get 1
jaara (i small pass test_nums add 1) start
    if na so (is_prime(i)) start
        shout("{i} is prime")
    end
    i get i add 1
end

shout("Testing 97:")
if na so (is_prime(97)) start
    shout("97 is prime")
end
if no be so start
    shout("97 is not prime") 
end

shout("Testing 100:")
if na so (is_prime(100)) start
    shout("100 is prime")
end
if no be so start
    shout("100 is not prime")
end
